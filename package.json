{
  "name": "astro-chaos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @io/site dev",
    "build": "pnpm --filter @io/site build",
    "preview": "pnpm --filter @io/site preview",
    "check": "pnpm --filter @io/site exec astro check",
    "lint": "oxlint",
    "clean": "node scripts/clean.mjs",
    "memory:check": "node scripts/memory-check.mjs",
    "format": "prettier --write \"packages/**/*.{ts,astro,css}\" \"apps/site/**/*.ts\"",
    "format:check": "prettier --check \"packages/**/*.{ts,astro,css}\" \"apps/site/**/*.ts\"",
    "test": "pnpm --filter astro-sage test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "oxlint": "^1.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
