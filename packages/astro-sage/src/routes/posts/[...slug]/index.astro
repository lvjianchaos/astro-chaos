---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import PostLayout from "@sage/layouts/PostLayout.astro";
import Header from "@sage/components/Header.astro";
import Footer from "@sage/components/Footer.astro";
import Datetime from "@sage/components/Datetime.astro";
import Tag from "@sage/components/Tag.astro";
import CategoryBadge from "@sage/components/CategoryBadge.astro";
import { getPostSlug } from "@sage/utils/getPostPaths";
import { getSortedPosts } from "@sage/utils/getSortedPosts";
import { slugifyStr } from "@sage/utils/slugify";
import EditPost from "./_components/EditPost.astro";
import AdjacentPostNav from "./_components/AdjacentPostNav.astro";
import config from "@sage/config";
import TableOfContents from "@sage/components/TableOfContents.astro";
import SeriesNav from "@sage/components/SeriesNav.astro";
import { readingTime, detectMeasure } from "@sage/utils/readingTime";
import { getSeriesPosts } from "@sage/utils/getSeries";
import { postFilter } from "@sage/utils/postFilter";
import { useTranslations, tplStr } from "@sage/i18n";
import "@sage/styles/post.css";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sortedPosts = getSortedPosts(posts);
  const published = posts.filter(postFilter);

  return sortedPosts.map((post, index) => ({
    params: { slug: getPostSlug(post.id, post.filePath) },
    props: {
      post,
      seriesPosts: post.data.series
        ? getSeriesPosts(published, post.data.series)
        : [],
      // sortedPosts is newest-first, so "older" (prev) is a higher index
      // and "newer" (next) is a lower index.
      prevPost:
        index < sortedPosts.length - 1
          ? {
              id: sortedPosts[index + 1].id,
              title: sortedPosts[index + 1].data.title,
              filePath: sortedPosts[index + 1].filePath,
            }
          : null,
      nextPost:
        index > 0
          ? {
              id: sortedPosts[index - 1].id,
              title: sortedPosts[index - 1].data.title,
              filePath: sortedPosts[index - 1].filePath,
            }
          : null,
    },
  }));
}

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  post: CollectionEntry<"posts">;
  seriesPosts: CollectionEntry<"posts">[];
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { post, seriesPosts, prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const {
  title,
  description,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  category,
  hideEditPost,
  series,
  toc,
  math,
} = post.data;

const { Content, headings } = await render(post);
const minutes = readingTime(post.body);
// Chinese posts use the 全角字 measure; mostly-Latin ones get the Latin one.
const measure = post.data.measure ?? detectMeasure(post.body);
const tocHeadings = headings.filter(
  h => h.depth >= 2 && h.depth <= 3 && h.slug !== "footnote-label"
);
const showToc = toc && tocHeadings.length > 1;
---

<PostLayout
  {math}
  title={`${title} | ${config.site.title}`}
  description={description}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <Header />

  <main id="main-content" class="app-layout mt-10 sm:mt-14" data-pagefind-body>
    <div
      class:list={[
        "post-grid",
        { "has-toc": showToc },
        { "measure-latin": measure === "latin" },
      ]}
    >
      <header class="post-header">
        {category && (
          <p class="post-category">
            <CategoryBadge name={category} />
          </p>
        )}
        {series && (
          <p class="small-caps mb-2 text-sm font-semibold">
            <a
              class="series-link"
              href={getRelativeLocaleUrl(
                locale,
                `series/${slugifyStr(series)}/`
              )}
            >
              {series}
            </a>
          </p>
        )}
        <h1 class="post-title">{title}</h1>
        {description && <p class="post-dek">{description}</p>}
        <div class="post-meta">
          <Datetime {pubDatetime} {modDatetime} {timezone} />
          <span aria-hidden="true">·</span>
          <span>{tplStr(t.post.minRead, { minutes })}</span>
        </div>
        {tags.length > 0 && (
          <ul
            class="post-tags"
            aria-label={t.post.tagLabel}
            data-pagefind-ignore
          >
            {tags.map(tag => (
              <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
            ))}
          </ul>
        )}
      </header>

      {showToc && (
        <TableOfContents
          headings={tocHeadings}
          variant="inline"
          class="post-toc-inline"
        />
      )}

      <article
        id="article"
        class="app-prose post-body"
        data-link-label={t.a11y.linkToSection}
      >
        <Content />
      </article>

      {showToc && (
        <aside class="post-rail" aria-label={t.a11y.tableOfContents}>
          <TableOfContents headings={tocHeadings} variant="rail" />
        </aside>
      )}

      <footer class="post-footer" data-pagefind-ignore>
        {seriesPosts.length > 1 && (
          <SeriesNav posts={seriesPosts} current={post.id} series={series!} />
        )}

        <div class="flex flex-wrap items-center justify-between gap-4">
          <EditPost {hideEditPost} {post} />
        </div>

        <hr class="border-border" />

        <AdjacentPostNav {prevPost} {nextPost} />
      </footer>
    </div>
  </main>
  <Footer />
</PostLayout>

<script>
  // Hover anchors on headings (tiny; avoids an extra build plugin).
  const article = document.querySelector<HTMLElement>("#article");
  const linkLabel = article?.dataset.linkLabel ?? "Link to section: ";
  for (const h of document.querySelectorAll<HTMLElement>(
    "#article :is(h2, h3, h4)[id]"
  )) {
    const a = document.createElement("a");
    a.href = `#${h.id}`;
    a.className = "heading-anchor";
    a.ariaLabel = `${linkLabel}${h.textContent}`;
    a.textContent = "#";
    h.prepend(a);
  }
</script>
