---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import config from "@sage/config";
import { useTranslations } from "@sage/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const currentYear = new Date().getFullYear();
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-border text-muted-foreground flex flex-col items-center justify-between gap-3 border-t py-8 text-sm sm:flex-row">
    <p>
      © {currentYear} {config.site.author}
      {config.site.repo && (
        <>
          {" · "}
          <a
            class="hover:text-accent underline decoration-dotted underline-offset-4"
            href={config.site.repo}
            rel="noopener"
          >
            {t.footer.credit}
          </a>
        </>
      )}
    </p>
    <Socials />
  </div>
</footer>
