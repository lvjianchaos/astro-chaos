---
import { getRelativeLocaleUrl } from "astro:i18n";
import { slugifyStr } from "@sage/utils/slugify";
import config from "@sage/config";

type Props = {
  /** The category label, e.g. "题解". */
  name: string;
  /** Smaller chip for cards and lists. */
  size?: "sm" | "md";
};

const { name, size = "md" } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const href = getRelativeLocaleUrl(locale, `categories/${slugifyStr(name)}/`);
---

<a class:list={["category-badge", size]} href={href}>
  {name}
</a>

<style>
  .category-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in oklab, var(--accent) 28%, transparent);
    border-radius: 0.25rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 120ms,
      border-color 120ms;
  }
  .category-badge.md {
    padding: 0.15em 0.5em;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }
  .category-badge.sm {
    padding: 0.1em 0.4em;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }
  .category-badge:hover,
  .category-badge:focus-visible {
    background: color-mix(in oklab, var(--accent) 18%, transparent);
    border-color: color-mix(in oklab, var(--accent) 45%, transparent);
  }
</style>
