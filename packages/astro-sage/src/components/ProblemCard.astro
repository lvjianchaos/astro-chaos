---
import { useTranslations } from "@sage/i18n";
import config from "@sage/config";

type Problem = {
  source?: string;
  id?: string;
  url?: string;
  difficulty?: string;
  limits?: string;
  tags?: string[];
};

type Props = {
  problem: Problem;
};

const { problem } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

{(problem.source || problem.id || problem.url || problem.difficulty) && (
  <aside class="problem-card" aria-label={t.problem.source}>
    <div class="problem-head">
      {problem.source && <span class="problem-source">{problem.source}</span>}
      {problem.id && <span class="problem-id">{problem.id}</span>}
      {problem.difficulty && (
        <span class="problem-diff">
          <span class="problem-label">{t.problem.difficulty}</span>
          {problem.difficulty}
        </span>
      )}
      {problem.limits && (
        <span class="problem-limits">
          <span class="problem-label">{t.problem.limits}</span>
          {problem.limits}
        </span>
      )}
    </div>

    {problem.tags && problem.tags.length > 0 && (
      <ul class="problem-tags">
        {problem.tags.map(tag => (
          <li>{tag}</li>
        ))}
      </ul>
    )}

    {problem.url && (
      <a class="problem-link" href={problem.url} rel="noopener">
        {t.problem.statement}
        <span aria-hidden="true">↗</span>
      </a>
    )}
  </aside>
)}

<style>
  .problem-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-block-end: 1.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-inline-start: 3px solid var(--accent);
    border-radius: 0.375rem;
    background: color-mix(in oklab, var(--accent) 4%, var(--bg));
    font-family: var(--font-ui);
    font-size: 0.85rem;
  }
  .problem-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
  }
  .problem-source {
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.02em;
  }
  .problem-id {
    font-weight: 600;
    color: var(--fg);
  }
  .problem-diff,
  .problem-limits {
    color: var(--fg-muted);
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
  }
  .problem-label {
    font-size: 0.85em;
    color: var(--fg-muted);
    opacity: 0.8;
  }
  .problem-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .problem-tags li {
    padding: 0.1em 0.45em;
    border-radius: 0.25rem;
    background: var(--bg-raised);
    color: var(--fg-muted);
    font-size: 0.95em;
  }
  .problem-link {
    margin-inline-start: auto;
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
  }
  .problem-link:hover,
  .problem-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
